rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Helpers
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.isPro is bool &&
             data.creditsRemaining is number && data.creditsRemaining >= 0 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024)) &&
             (!('preferredLanguage' in data) || (data.preferredLanguage in ['en', 'pt', 'es', 'fr', 'de', 'it'])) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    function isValidHistoryItem(data, userId) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.userId == request.auth.uid &&
             data.options is list &&
             data.options.size() > 0 && data.options.size() <= 10 &&
             data.options[0] is string &&
             data.analysis is string && data.analysis.size() <= 5000 &&
             (!('inputContext' in data) || (data.inputContext is string && data.inputContext.size() <= 4000)) &&
             (!('goal' in data) || (data.goal is string && data.goal.size() <= 128)) &&
             (!('tone' in data) || (data.tone is string && data.tone.size() <= 128)) &&
             (!('spiciness' in data) || (data.spiciness is number && data.spiciness >= 1 && data.spiciness <= 5)) &&
             (!('followUpAdvice' in data) || (data.followUpAdvice is string && data.followUpAdvice.size() <= 3000)) &&
             (!('isFavorite' in data) || data.isFavorite is bool) &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 64));
    }

    function isValidMorningTracker(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.firstSeenTimestamp is number &&
             data.notificationsEnabled is bool &&
             (!('lastNotifiedDate' in data) || (data.lastNotifiedDate is string && data.lastNotifiedDate.size() <= 32)) &&
             (!('currentDay' in data) || (data.currentDay is number && data.currentDay >= 1 && data.currentDay <= 30)) &&
             (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() <= 64));
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId) && resource.data.id == request.auth.uid;
      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId;
      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User History Subcollection
      match /history/{historyId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(historyId) &&
                         isValidHistoryItem(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(historyId) &&
                         isValidHistoryItem(incoming(), userId) &&
                         incoming().id == existing().id &&
                         incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(historyId);
      }

      // User Morning Tracker Subcollection
      match /morningTracker/{trackerId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) &&
                         isValidId(trackerId) &&
                         isValidMorningTracker(incoming(), userId);
        allow update: if isOwner(userId) &&
                         isValidId(trackerId) &&
                         isValidMorningTracker(incoming(), userId);
        allow delete: if isOwner(userId) && isValidId(trackerId);
      }
    }
  }
}
